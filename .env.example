# Copy to .env for local overrides. docker-compose sets these for the container.
PORT=3000
HOST=0.0.0.0
LOG_LEVEL=info

# Local host MongoDB; docker-compose uses mongodb://mongo:27017
MONGODB_URI=mongodb://127.0.0.1:27017
MONGODB_DB=biteexpress
MONGODB_MAX_POOL_SIZE=20
MONGODB_MIN_POOL_SIZE=2

TENANT_ID=biteexpress
